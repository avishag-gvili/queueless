# Database
DB_USER=queueless
DB_PASSWORD=changeme
DB_NAME=queueless

# JWT
JWT_SECRET=replace-me-with-a-long-random-string

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# ====================================================================
# Email — Gmail SMTP
# ====================================================================
# When EMAIL_SEND_REAL=false (default), emails are logged but not sent.
# Safe for local development and CI.
#
# To send real emails via Gmail:
# 1. Use a Gmail account with 2FA enabled
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Fill SMTP_USER and SMTP_PASSWORD below
# 4. Set EMAIL_SEND_REAL=true
# 5. Restart the api container: docker compose restart api
# 6. Test with: make test-email TO=somewhere@example.com
#
# Gmail SMTP limit: 500 emails per day for personal accounts.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                       # your-system@gmail.com
SMTP_PASSWORD=                   # 16-character App Password
SMTP_FROM=                       # same as SMTP_USER for Gmail
EMAIL_SEND_REAL=false
